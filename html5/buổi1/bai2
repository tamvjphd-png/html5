<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buổi 1 - Bài 2: CV cá nhân (Semantic HTML5)</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            color: #222;
            background: #fafafa;
        }

        header {
            background: #34495e;
            color: #fff;
            padding: 24px;
            display: flex;
            align-items: center;
            gap: 20px;
        }

        header figure {
            margin: 0;
            text-align: center;
        }

        header figure img {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            display: block;
        }

        header figcaption {
            font-size: 12px;
            color: #ccc;
            margin-top: 4px;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 16px;
            padding: 0;
            margin: 8px 0 0;
        }

        nav a {
            color: #fff;
            text-decoration: none;
        }

        main {
            padding: 24px;
            max-width: 800px;
            margin: 0 auto;
        }

        section {
            background: #fff;
            padding: 16px 20px;
            margin-bottom: 20px;
            border-radius: 6px;
        }

        article {
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        article:last-child {
            border-bottom: none;
        }

        aside {
            background: #eef2f5;
            padding: 16px 20px;
            border-radius: 6px;
        }

        footer {
            text-align: center;
            padding: 16px;
            color: #777;
        }

        time {
            color: #888;
            font-size: 14px;
        }
    </style>
</head>

<body>
    <!-- ===== HEADER: ảnh đại diện dùng figure + figcaption theo đúng yêu cầu bài tập ===== -->
    <header>
        <figure>
            <img src="avatar.jpg" alt="Ảnh đại diện của Nguyễn Văn A">
            <figcaption>Nguyễn Văn A</figcaption>
        </figure>
        <div>
            <h1>Nguyễn Văn A</h1>
            <p>Sinh viên ngành Công nghệ thông tin</p>
            <nav>
                <ul>
                    <li><a href="#hoc-van">Học vấn</a></li>
                    <li><a href="#kinh-nghiem">Kinh nghiệm</a></li>
                    <li><a href="#ky-nang">Kỹ năng</a></li>
                </ul>
            </nav>
        </div>
    </header>
    <main>
        <section id="hoc-van">
            <h2>Học vấn</h2>

            <article>
                <h3>Cao đẳng Công nghệ thông tin</h3>
                <p>Trường Cao đẳng ABC</p>
                <p><time datetime="2023-09">09/2023</time> — hiện tại</p>
            </article>
        </section>
        <section id="kinh-nghiem">
            <h2>Kinh nghiệm</h2>
            <article>
                <h3>Thực tập sinh Frontend</h3>
                <p>Công ty XYZ Technology</p>
                <p><time datetime="2025-06">06/2025</time> — <time datetime="2025-12">12/2025</time></p>
                <p>Tham gia xây dựng giao diện web bằng HTML5, CSS3 và JavaScript cơ bản.</p>
            </article>
        </section>
        <section id="ky-nang">
            <h2>Kỹ năng</h2>
            <ul>
                <li>HTML5 &amp; CSS3</li>
                <li>JavaScript cơ bản</li>
                <li>Git &amp; GitHub</li>
                <li>Làm việc nhóm</li>
            </ul>
        </section>
    </main>
    <!-- ===== ASIDE: thông tin phụ - liên hệ ===== -->

    <aside>
        <h3>Thông tin liên hệ</h3>
        <p>Email: <a href="mailto:nguyenvana@example.com">nguyenvana@example.com</a></p>
        <p>Điện thoại: <a href="tel:0912345678">0912 345 678</a></p>
    </aside>
    <footer>
        <p>&copy; 2026 Nguyễn Văn A</p>
    </footer>
</body>

</html>